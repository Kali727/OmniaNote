# Copy to infra/.env and fill in real values before running `docker compose up`.
# This file is consumed two ways: docker-compose.yml substitutes ${VARS} into service
# config, and the same file is passed to the api container as its runtime environment.

# --- Postgres ---
POSTGRES_USER=omnianote
POSTGRES_PASSWORD=change-me
POSTGRES_DB=omnianote

# --- MinIO / S3 ---
S3_ACCESS_KEY_ID=omnianote
S3_SECRET_ACCESS_KEY=change-me-min-8-chars
S3_BUCKET=omnianote-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me-min-16-chars

# --- Reverse proxy ---
# A real domain (e.g. notes.example.com) so Caddy can obtain a TLS cert automatically.
DOMAIN=localhost

# --- API: auth & app config (see apps/api/.env.example for how to generate these) ---
NODE_ENV=production
PORT=3000
JWT_ACCESS_SECRET=replace-with-a-random-48-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-48-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MFA_TOTP_ENCRYPTION_KEY=replace-with-a-random-32-byte-key
CORS_ORIGIN=https://localhost
