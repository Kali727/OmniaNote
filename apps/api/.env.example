NODE_ENV=development
PORT=3000

# postgres://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql://omnianote:omnianote@localhost:5432/omnianote

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-48-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-48-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Generate with: openssl rand -base64 32 — encrypts TOTP secrets at rest
MFA_TOTP_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# MinIO locally; swap for real S3 in production by changing these four values
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=omnianote-media
S3_ACCESS_KEY_ID=omnianote
S3_SECRET_ACCESS_KEY=omnianote-dev-secret
S3_FORCE_PATH_STYLE=true

REDIS_URL=redis://localhost:6379

CORS_ORIGIN=*

# Optional — leave unset and MFA email codes just log to the console instead of sending.
# Get a key at https://resend.com (free tier: 3,000 emails/month, no card required).
# The default FROM address needs no domain verification; switch it once you've verified
# your own sending domain there for better deliverability.
RESEND_API_KEY=
RESEND_FROM_EMAIL=OmniaNote <onboarding@resend.dev>
